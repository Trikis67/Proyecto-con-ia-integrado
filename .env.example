# Copia este archivo como .env.local y llena los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo servidor: la usa el recolector de licitaciones. Nunca la expongas en el navegador.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Fase 2: IA
ANTHROPIC_API_KEY=
